  "item": [
    {
      "name": "GET-查询单个用户-id=2",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 校验状态码为200\r\npm.test(\"响应状态码是200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n// 校验返回data里id等于2\r\npm.test(\"返回用户id=2\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData.data.id).to.eql(2);\r\n});\r\n// 校验email字段存在\r\npm.test(\"返回包含email字段\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData.data.email).to.exist;\r\n});\r\n"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://reqres.in/api/users/2",
          "protocol": "https",
          "host": [
            "reqres",
            "in"
          ],
          "path": [
            "api",
            "users",
            "2"
          ]
        }
      },
      "response": []
    },
